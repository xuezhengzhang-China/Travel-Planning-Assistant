{
  "name": "travel-planner-v2",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"npm run dev --workspace=@travel/api\" \"npm run dev --workspace=@travel/web\"",
    "dev:api": "npm run dev --workspace=@travel/api",
    "dev:web": "npm run dev --workspace=@travel/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace=@travel/api && npm run test --workspace=@travel/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate --workspace=@travel/api",
    "db:migrate:status": "npm run db:migrate:status --workspace=@travel/api",
    "db:seed:b": "npm run db:seed:b --workspace=@travel/api",
    "test:integration:b": "npm run build --workspace=@travel/api && npm run test:integration:b --workspace=@travel/api",
    "db:tunnel:b": "ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:55432:127.0.0.1:55432 -p 22 ubuntu@120.53.94.209",
    "services:tunnel:b": "ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:55432:127.0.0.1:55432 -L 127.0.0.1:11434:127.0.0.1:11434 -p 22 ubuntu@120.53.94.209",
    "acceptance:b": "node apps/api/scripts/acceptance/run.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  }
}
