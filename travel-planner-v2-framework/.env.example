# Database (local host development)
POSTGRES_DB=travel_planner
POSTGRES_USER=travel_planner
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://travel_planner:change-me-local-only@localhost:5432/travel_planner

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
DB_CONNECTION_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=10000
# Set a stable random value (at least 32 bytes) for persistent sessions; blank uses a per-process key.
AUTH_TOKEN_SECRET=
# Optional Vite server-side proxy override; otherwise follows PORT.
API_PROXY_TARGET=

# AMap: Web JS key is public in the browser; restrict it by allowed domain in AMap console.
VITE_AMAP_WEB_KEY=
# Server-side key. Never use a VITE_ prefix for secrets.
AMAP_WEB_SERVICE_KEY=
B_EXTERNAL_TIMEOUT_MS=3000
B_GENERATION_TIMEOUT_MS=20000
B_MAX_ROUTE_CALLS=40
B_PROPOSAL_TTL_MINUTES=30
# Dedicated, pre-created test database only. Never point at a development/production database.
TEST_DATABASE_URL=

# Optional server-side LLM configuration
B_LLM_ENABLED=false
# Model timeout is separate from the map timeout; the total generation deadline still applies.
B_LLM_TIMEOUT_MS=15000
# OpenAI-compatible Chat Completions API base, including /v1 if required by the provider.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
