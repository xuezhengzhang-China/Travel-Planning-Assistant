# Database (local host development)
POSTGRES_DB=travel_planner
POSTGRES_USER=travel_planner
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://travel_planner:change-me-local-only@localhost:5432/travel_planner

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# AMap: Web JS key is public in the browser; restrict it by allowed domain in AMap console.
VITE_AMAP_WEB_KEY=
# Server-side key. Never use a VITE_ prefix for secrets.
AMAP_WEB_SERVICE_KEY=

# Optional server-side LLM configuration
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
