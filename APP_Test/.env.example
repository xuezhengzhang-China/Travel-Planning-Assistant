# Copy this file to .env and set TPA_APP_ENV_FILE to its absolute path.
# No secrets from the actual server are included here.
# Existing process environment variables take precedence.
TEST_DATABASE_URL=postgresql://TEST_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/travel_planner_app_test

# Real calls are disabled until explicitly enabled for the full suite.
TPA_APP_REAL_MODEL=0
LLM_API_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:0.5b
LLM_API_KEY=ollama-local-test-only

TPA_APP_REAL_AMAP=0
AMAP_WEB_SERVICE_KEY=

# Windows: use the installed Edge. Set empty to use Playwright Chromium.
TPA_BROWSER_CHANNEL=msedge
