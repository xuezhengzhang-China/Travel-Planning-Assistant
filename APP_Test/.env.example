# Copy to a private file, then point TPA_TDD_ENV_FILE to its absolute path.
# The runner reads only TEST_DATABASE_URL from that file.
# Use the server PostgreSQL test database; no local Docker is needed.
# Replace the placeholders and URL-encode special characters in credentials.
TEST_DATABASE_URL=postgresql://TEST_USER:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:55432/travel_planner_b_test
