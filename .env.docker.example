# Local Docker setup. Copy to .env or run 启动漫游Docker.ps1.
# The app generates a random first-admin password and prints it in the logs.
COMPOSE_PROJECT_NAME=manyou
HOST_PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=info
APP_VERSION=local
# This package binds the app to localhost only; this is needed for HTTP login.
COOKIE_SECURE=false
